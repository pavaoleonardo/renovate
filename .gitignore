# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.md
*.pdf
# keep agent working rules versioned (AGENTS.md / .github/copilot-instructions.md)
!AGENTS.md
!.github/copilot-instructions.md
# Product docs stay local-only (SPEC.md, README.md, docs/**): git is not their backup.
# The durable homes are the local file, the Obsidian mirror and Engram. AGENTS.md and
# .github/copilot-instructions.md above are the only deliberate *.md exceptions.
# Re-check after editing: `git check-ignore -v docs/catalogo-precios.md` must match *.md.

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
